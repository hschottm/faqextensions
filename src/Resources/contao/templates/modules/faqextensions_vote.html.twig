{% if showhelpful %}
  <div class="helpful">
    <div>{{ 'tl_faq.nOutofmFoundThisArticleHelpful'|trans({}, 'contao_tl_faq')|format(helpful, helpful + nothelpful) }}</div>
    <div>
      {{ 'tl_faq.WasThisArticleHelpful'|trans({}, 'contao_tl_faq') }}
      <a href="{{ insert_tag('faq_helpful_url::' ~ (alias ?: (faqId|default(id)))) }}" rel="nofollow">{{ 'vote.yes'|trans({}, 'faqextensions') }}</a> |
      <a href="{{ insert_tag('faq_nothelpful_url::' ~ (alias ?: (faqId|default(id)))) }}" rel="nofollow">{{ 'vote.no'|trans({}, 'faqextensions') }}</a>
    </div>
  </div>
{% endif %}
